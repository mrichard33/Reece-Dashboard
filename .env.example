# LP Supabase (lp_*, agent_*, claude_*, system_events, groupme_approval_requests)
LP_SUPABASE_URL=
LP_SUPABASE_ANON_KEY=
LP_SUPABASE_SERVICE_KEY=
LP_SUPABASE_PROJECT_ID=

# Browser-exposed equivalents (NEXT_PUBLIC_*) so client components can read them.
# Anon key is safe to ship to the browser; service key MUST NOT be NEXT_PUBLIC.
NEXT_PUBLIC_LP_SUPABASE_URL=
NEXT_PUBLIC_LP_SUPABASE_ANON_KEY=

# HL Supabase (contacts, opportunities, workflows, etc.)
HL_SUPABASE_URL=
HL_SUPABASE_ANON_KEY=
HL_SUPABASE_SERVICE_KEY=
HL_SUPABASE_PROJECT_ID=

# MCP endpoints (server-side live calls only).
# Use the BASE URL only — the client speaks the MCP protocol at POST <url>/mcp
# (StreamableHTTP). Do not append a path. The *_AUTH_TOKEN values must match
# each server's MCP_AUTH_TOKEN (leave blank only if that server runs open).
LP_MCP_URL=https://lp-mcp-production.up.railway.app
HL_MCP_URL=https://hl-workflow-intelligence-mcp-production.up.railway.app
LP_MCP_AUTH_TOKEN=
HL_MCP_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Executive Review notifications (server-side only). Leave unset to no-op:
# email-on-submit and the GroupMe ping degrade gracefully until provisioned.
RESEND_API_KEY=
RESEND_FROM=
GROUPME_BOT_ID=

# ── Facebook Content Engine (dashboard side only) ──────────────────
# The Dashboard fires authenticated webhooks at n8n on reject / generate-now /
# run-miner / strategic-refresh. Unset = the Content area still works; the n8n
# triggers no-op (the calendar, approvals, and feedback logging all run locally).
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# "Copy + Open Group" runs in the browser, so the Group URL must be NEXT_PUBLIC.
FB_GROUP_URL=
NEXT_PUBLIC_FB_GROUP_URL=
# Regeneration cap before a slot is flagged for manual authoring (default 3).
MAX_REGEN_ATTEMPTS=3
# Approver allowlist (spec §1/§9) for approve/reject/mark-posted, comma-separated.
# Layered on top of the executive-based RLS (an approver must also be an executive).
# Leave unset to fall back to executive-only gating.
APPROVER_EMAILS=
# GHL contact tag that marks a Facebook group opt-in (Insights "Group members").
# Defaults to fb-group-optin; set if Mark's §11 funnel uses a different tag.
FB_GROUP_OPTIN_TAG=fb-group-optin
# NOTE: the Anthropic model + key, image-provider key, Meta Page token/ID, and
# GHL keys live in n8n (see n8n/README.md), NOT the dashboard.
