# LP Supabase (lp_*, agent_*, claude_*, system_events, groupme_approval_requests)
LP_SUPABASE_URL=
LP_SUPABASE_ANON_KEY=
LP_SUPABASE_SERVICE_KEY=
LP_SUPABASE_PROJECT_ID=

# Browser-exposed equivalents (NEXT_PUBLIC_*) so client components can read them.
# Anon key is safe to ship to the browser; service key MUST NOT be NEXT_PUBLIC.
NEXT_PUBLIC_LP_SUPABASE_URL=
NEXT_PUBLIC_LP_SUPABASE_ANON_KEY=

# HL Supabase (contacts, opportunities, workflows, etc.)
HL_SUPABASE_URL=
HL_SUPABASE_ANON_KEY=
HL_SUPABASE_SERVICE_KEY=
HL_SUPABASE_PROJECT_ID=

# MCP endpoints (server-side live calls only).
# Use the BASE URL only — the client speaks the MCP protocol at POST <url>/mcp
# (StreamableHTTP). Do not append a path. The *_AUTH_TOKEN values must match
# each server's MCP_AUTH_TOKEN (leave blank only if that server runs open).
#
# SYMPTOM OF A STALE/MISSING TOKEN: the LP/HL status tiles and the Settings →
# Connections panel show "Auth failed — 401" with an actionable message. The fix
# is NOT in code: copy each MCP service's MCP_AUTH_TOKEN (Railway) into the
# matching value here on the Dashboard's Railway service, then redeploy. These
# tokens authenticate the dashboard itself, so they live in env only — never in a
# DB and never editable from the UI.
LP_MCP_URL=https://lp-mcp-production.up.railway.app
HL_MCP_URL=https://hl-workflow-intelligence-mcp-production.up.railway.app
LP_MCP_AUTH_TOKEN=
HL_MCP_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Executive Review notifications (server-side only). Leave unset to no-op:
# email-on-submit and the GroupMe ping degrade gracefully until provisioned.
RESEND_API_KEY=
RESEND_FROM=
GROUPME_BOT_ID=

# ── Facebook Content Engine (dashboard side only) ──────────────────
# The Dashboard fires authenticated webhooks at n8n on reject / generate-now /
# run-miner / strategic-refresh / plan-period / generate-batch. Unset = the Content
# area still works; the n8n triggers no-op (the calendar, approvals, and feedback
# logging all run locally).
# N8N_BASE_URL is the base domain only — postWebhook() appends /webhook/<path>.
# The secret is sent as the `x-webhook-secret` header (n8n redacts Authorization),
# so it must match the value in each workflow's Verify Secret node.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# "Copy + Open Group" runs in the browser, so the Group URL must be NEXT_PUBLIC.
FB_GROUP_URL=
NEXT_PUBLIC_FB_GROUP_URL=
# ── Generation tuning — FALLBACKS ONLY ────────────────────────────
# Primary values now live in fb_settings and are managed from /content/settings
# (DB → these env vars → built-in default, resolved per-action). Set these only
# as a fallback for when the DB column is null.
# Regeneration cap before a slot is flagged for manual authoring (default 3).
MAX_REGEN_ATTEMPTS=3
# Hard cap on how many planned slots one batch run may fill (also the default N).
MAX_PER_GENERATION=7
# How far ahead the nightly generator keeps FINISHED drafts (buffer top-up window).
# Consumed by n8n WF1 (read from fb_settings.generation_buffer_days at runtime).
GENERATION_BUFFER_DAYS=7
# Default planning window for the "Plan next N days" action.
PLAN_HORIZON_DAYS=30
# Anthropic model the workflows use. This primarily lives in n8n (see below); set
# here only if a dashboard-side code path needs it. Example: claude-sonnet-4-6.
ANTHROPIC_MODEL=
# Approver allowlist for approve/reject/mark-posted, comma-separated. LEGACY
# FALLBACK: approver roles are now managed in /settings → Team & Approvers
# (executives.is_approver). Resolution order: if any executive is flagged
# is_approver, those DB flags win; else this env list; else any executive.
APPROVER_EMAILS=
# GHL contact tag that marks a Facebook group opt-in (Insights "Group members").
# Defaults to fb-group-optin; set if Mark's §11 funnel uses a different tag.
FB_GROUP_OPTIN_TAG=fb-group-optin
# NOTE: the Anthropic model + key, image-provider key, and GHL keys live in n8n
# (see n8n/README.md), NOT the dashboard. The Meta Page token + ID now live in LP
# Supabase (fb_settings / fb_secrets), managed from the dashboard /settings page and
# read by WF4 at runtime — they are NOT in n8n env. n8n needs only the LP service
# key (LP_SUPABASE_SERVICE_KEY) in its Railway env to read that config.
