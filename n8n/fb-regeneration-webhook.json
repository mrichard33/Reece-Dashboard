      "id": "wf3-gen-image-0000017",
      "name": "Generate Image (swappable)"
    },
    {
      "parameters": {
        "jsCode": "// Decode the base64 image returned by the provider and prepare it as binary for upload.\nconst b64 = $json.data?.[0]?.b64_json;\nif (!b64) throw new Error('No image returned');\nconst path = `${$now.toFormat('yyyy-LL-dd')}-${Math.random().toString(36).slice(2,10)}.png`;\nreturn [{ json: { path }, binary: { data: await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), path, 'image/png') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        200
