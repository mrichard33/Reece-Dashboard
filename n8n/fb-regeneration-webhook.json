    {
      "parameters": {
        "jsCode": "// Build regeneration context from the rejected post + the rejection reason.\n// Reuses WF1's prompt-merge logic; runs in REGENERATION MODE (prepends rejection_feedback).\n// When the image was approved (copy-only reject), reuse the kept image_concept so the\n// image is preserved. Returns { system, user, component, regen_copy, regen_image,\n// post_id, image_concept, image_status }.\nconst post = $('Get Post').first().json;\nconst body = $('Webhook (fb-regenerate)').first().json.body;\nconst component = body.component;\nconst promptItems = $('Get Prompts + Bank').all();\nconst byName = Object.fromEntries(promptItems.map(i => [i.json.name, i.json.body]));\nconst bank = $('Get Message Bank').first()?.json?.variables ?? {};\n\nconst regen_copy = component === 'copy' || component === 'both';\nconst regen_image = component === 'image' || component === 'both';\nconst rejection_feedback = (body.reason_code || '') + ': ' + (body.reason_text || '');\nconst kept_image_concept = (post.image_status === 'approved') ? (post.image_concept || '') : '';\n\nlet user = (byName['generator'] || '')\n  .replaceAll('{{style_guide}}', byName['style_guide'] || '')\n  .replaceAll('{{message_bank}}', JSON.stringify(bank))\n  .replaceAll('{{pillar}}', post.pillar || '')\n  .replaceAll('{{archetype}}', post.archetype || '')\n  .replaceAll('{{subtopic}}', '');\nuser = 'REGENERATION MODE. The previous draft was rejected.\\n'\n  + 'rejection_feedback: ' + rejection_feedback + '\\n'\n  + (kept_image_concept ? ('Keep the existing image; reuse this image_concept verbatim: ' + kept_image_concept + '\\n') : '')\n  + 'Previous post_body: ' + (post.post_body || '') + '\\n'\n  + 'Previous first_comment: ' + (post.first_comment || '') + '\\n\\n'\n  + user;\n\nreturn [{ json: {\n  system: byName['style_guide'] || '',\n  user,\n  component, regen_copy, regen_image,\n  post_id: post.id,\n  image_concept: kept_image_concept || (post.image_concept || ''),\n  image_status: post.image_status\n} }];"
      },
