      "name": "Anthropic: Regenerate Copy"
    },
    {
      "parameters": {
        "jsCode": "// Tolerant JSON parse: strip ```json fences, then JSON.parse; on failure extract\n// the first balanced {...}. Returns the regenerated object { post_body, first_comment, image_concept, ... }.\nlet t = $json.content?.[0]?.text || '';\nt = t.replace(/```json|```/g, '').trim();\nlet out;\ntry { out = JSON.parse(t); } catch (e) {\n  const m = t.match(/\\{[\\s\\S]*\\}/); out = m ? JSON.parse(m[0]) : {};\n}\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "id": "wf3-parse-copy-0000012",
      "name": "Parse Regen Copy"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=__SUPABASE_URL__/rest/v1/fb_posts?id=eq.{{ $('Webhook (fb-regenerate)').item.json.body.post_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
