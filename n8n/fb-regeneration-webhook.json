    {
      "parameters": {
        "jsCode": "// Effective image concept for regeneration: prefer a freshly regenerated concept\n// (component='both'), else fall back to the existing/kept concept.\nlet concept = '';\ntry { concept = $('Parse Regen Copy').first().json.image_concept; } catch (e) {}\nif (!concept) concept = $('Build Regen Context').first().json.image_concept || '';\nreturn [{ json: { concept } }];"
      },
