        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: '__ANTHROPIC_MODEL__', max_tokens: 1200, system: $('Build Regen Context').first().json.system, messages: [ { role: 'user', content: $('Build Regen Context').first().json.user } ] }) }}",
