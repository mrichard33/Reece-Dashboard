            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_body: $('Parse Regen Copy').first().json.post_body, first_comment: $('Parse Regen Copy').first().json.first_comment, copy_status: 'pending' }) }}",
        "options": {}
