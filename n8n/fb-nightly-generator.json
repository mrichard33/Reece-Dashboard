{
  "name": "FB · Nightly Generator (WF1)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        120
      ],
      "id": "wf1-schedule-0000-0000-000000000001",
      "name": "Nightly 06:00 ET"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fb-generate-now",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -220,
        360
      ],
      "id": "wf1-webhook-0000-0000-000000000002",
      "name": "On-demand (fb-generate-now)",
      "webhookId": "fb-generate-now"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "secret",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "=__N8N_WEBHOOK_SECRET__",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
