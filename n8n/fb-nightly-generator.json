    "Get Prompts + Bank": { "main": [ [ { "node": "Build Generator Prompt", "type": "main", "index": 0 } ] ] },
    "Build Generator Prompt": { "main": [ [ { "node": "Anthropic: Generator", "type": "main", "index": 0 } ] ] },
    "Anthropic: Generator": { "main": [ [ { "node": "Parse JSON (tolerant)", "type": "main", "index": 0 } ] ] },
    "Parse JSON (tolerant)": { "main": [ [ { "node": "Anthropic: Image Prompt", "type": "main", "index": 0 } ] ] },
    "Anthropic: Image Prompt": { "main": [ [ { "node": "Generate Image (swappable)", "type": "main", "index": 0 } ] ] },
    "Generate Image (swappable)": { "main": [ [ { "node": "Upload to fb-images", "type": "main", "index": 0 } ] ] },
    "Upload to fb-images": { "main": [ [ { "node": "Insert fb_posts (public image URL)", "type": "main", "index": 0 } ] ] },
    "Insert fb_posts (public image URL)": { "main": [ [ { "node": "GroupMe Notify", "type": "main", "index": 0 } ] ] },
    "GroupMe Notify": { "main": [ [ { "node": "Respond", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/New_York" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [ { "id": "fb-content-engine", "name": "FB Content Engine" } ]
}
