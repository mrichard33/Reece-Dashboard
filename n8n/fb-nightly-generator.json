        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ last_used_at: new Date().toISOString(), times_used: ($('Build Generator Prompt').first().json.times_used || 0) + 1 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3080,
        240
      ],
      "id": "wf1-bump-subtopic-00000021",
      "name": "Bump Subtopic"
