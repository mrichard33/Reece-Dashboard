      "typeVersion": 2,
      "position": [
        0,
        360
      ],
      "id": "wf1-verify-0000-0000-000000000003",
      "name": "Verify Secret"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__SUPABASE_URL__/rest/v1/fb_posts?select=scheduled_date&scheduled_date=gte.{{ $now.toFormat('yyyy-LL-dd') }}&order=scheduled_date.asc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        0,
        120
      ],
      "id": "wf1-get-dates-00000000016",
      "name": "Get Existing Dates",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Fill the first open date within a 5-day horizon from today (skip dates that already have a row).\n// PostgREST array responses arrive as separate items in this n8n instance, so read them all.\nconst items = $('Get Existing Dates').all();\nconst taken = new Set(items.map(i => i.json && i.json.scheduled_date).filter(Boolean));\nconst d = new Date();\nlet target = null;\nfor (let i = 0; i < 5; i++) {\n  const iso = new Date(d.getTime() + i * 864e5).toISOString().slice(0, 10);\n  if (!taken.has(iso)) { target = iso; break; }\n}\nif (!target) return [];               // horizon full -> emit nothing (no-op night)\nreturn [{ json: { scheduled_date: target } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        120
      ],
      "id": "wf1-pick-date-00000000017",
      "name": "Pick Next Open Date"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__SUPABASE_URL__/rest/v1/fb_subtopics?status=eq.active&order=last_used_at.asc.nullsfirst,times_used.asc&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        440,
        240
      ],
      "id": "wf1-get-subtopic-000000000004",
      "name": "Get LRU Subtopic"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__SUPABASE_URL__/rest/v1/fb_message_bank?is_active=eq.true&select=variables&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        240
      ],
      "id": "wf1-get-bank-00000000018",
      "name": "Get Message Bank"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__SUPABASE_URL__/rest/v1/fb_messaging_prompts?is_active=eq.true&select=name,body",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        880,
        240
      ],
      "id": "wf1-get-prompts-0000000000005",
      "name": "Get Prompts + Bank"
    },
    {
      "parameters": {
        "jsCode": "// Merge subtopic + prompts + message bank into the generator system/user prompts.\n// Single-row reads (.first().json) and multi-row reads (.all()) per this instance's\n// PostgREST-array-splitting behaviour. Returns { system, user, subtopic_id, pillar,\n// times_used, archetype, scheduled_date }.\nconst subtopic = $('Get LRU Subtopic').first().json;\nconst promptItems = $('Get Prompts + Bank').all();\nconst byName = Object.fromEntries(promptItems.map(i => [i.json.name, i.json.body]));\nconst bank = $('Get Message Bank').first()?.json?.variables ?? {};\n\nconst archetypes = ['myth-bust','secret-reveal','story','mistake-expose','seasonal','thought-leadership','community-cause','social-proof'];\nconst archetype = archetypes[new Date().getDate() % archetypes.length];\n\nconst user = (byName['generator'] || '')\n  .replaceAll('{{style_guide}}', byName['style_guide'] || '')\n  .replaceAll('{{message_bank}}', JSON.stringify(bank))\n  .replaceAll('{{pillar}}', subtopic.pillar || '')\n  .replaceAll('{{archetype}}', archetype)\n  .replaceAll('{{subtopic}}', subtopic.subtopic || '');\n\n// scheduled_date comes from the webhook body (on-demand) or Pick Next Open Date (nightly).\nlet scheduled_date = null;\ntry { scheduled_date = $('On-demand (fb-generate-now)').first().json.body.scheduled_date; } catch (e) {}\nif (!scheduled_date) { try { scheduled_date = $('Pick Next Open Date').first().json.scheduled_date; } catch (e) {} }\n\nreturn [{ json: {\n  system: byName['style_guide'] || '',\n  user,\n  subtopic_id: subtopic.id,\n  pillar: subtopic.pillar,\n  times_used: subtopic.times_used || 0,\n  archetype,\n  scheduled_date\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        240
      ],
      "id": "wf1-build-prompt-000000000006",
      "name": "Build Generator Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "__ANTHROPIC_API_KEY__"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: '__ANTHROPIC_MODEL__', max_tokens: 1200, system: $json.system, messages: [ { role: 'user', content: $json.user } ] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1320,
        240
      ],
      "id": "wf1-anthropic-gen-00000000007",
      "name": "Anthropic: Generator"
    },
    {
      "parameters": {
        "jsCode": "// Tolerant JSON parse: strip ```json fences, then JSON.parse; on failure extract\n// the first balanced {...}. Returns the generator object { post_body, first_comment, image_concept, ... }.\nlet t = $json.content?.[0]?.text || '';\nt = t.replace(/```json|```/g, '').trim();\nlet out;\ntry { out = JSON.parse(t); } catch (e) {\n  const m = t.match(/\\{[\\s\\S]*\\}/); out = m ? JSON.parse(m[0]) : {};\n}\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        240
      ],
      "id": "wf1-parse-gen-000000000008",
      "name": "Parse JSON (tolerant)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "__ANTHROPIC_API_KEY__"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: '__ANTHROPIC_MODEL__', max_tokens: 400, messages: [ { role: 'user', content: 'Image prompt for: ' + $json.image_concept } ] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1760,
        240
      ],
      "id": "wf1-anthropic-img-00000000009",
      "name": "Anthropic: Image Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __IMAGE_API_KEY__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-image-1', prompt: $json.content?.[0]?.text || '', size: '1024x1024', n: 1 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1980,
        240
      ],
      "id": "wf1-gen-image-0000000000010",
      "name": "Generate Image (swappable)"
    },
    {
      "parameters": {
        "jsCode": "// Decode the base64 image returned by the provider and prepare it as binary for upload.\nconst b64 = $json.data?.[0]?.b64_json;\nif (!b64) throw new Error('No image returned');\nconst path = `${$now.toFormat('yyyy-LL-dd')}-${Math.random().toString(36).slice(2,10)}.png`;\nreturn [{ json: { path }, binary: { data: await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), path, 'image/png') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        240
      ],
      "id": "wf1-decode-img-00000000019",
      "name": "Decode Image"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=__SUPABASE_URL__/storage/v1/object/fb-images/{{ $json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "x-upsert",
              "value": "true"
            },
            {
              "name": "Content-Type",
              "value": "image/png"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2420,
        240
      ],
      "id": "wf1-upload-0000000000011",
      "name": "Upload to fb-images"
    },
    {
      "parameters": {
        "jsCode": "// Public read URL for the uploaded image (note the /public/ segment).\nreturn [{ json: { image_url: `${$env.SUPABASE_URL || '__SUPABASE_URL__'}/storage/v1/object/public/fb-images/${$('Decode Image').first().json.path}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        240
      ],
      "id": "wf1-set-url-00000000020",
      "name": "Set image_url"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__SUPABASE_URL__/rest/v1/fb_posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scheduled_date: $('Build Generator Prompt').first().json.scheduled_date, target: 'both', pillar: $('Build Generator Prompt').first().json.pillar, archetype: $('Build Generator Prompt').first().json.archetype, subtopic_id: $('Build Generator Prompt').first().json.subtopic_id, post_body: $('Parse JSON (tolerant)').first().json.post_body, first_comment: $('Parse JSON (tolerant)').first().json.first_comment, image_concept: $('Parse JSON (tolerant)').first().json.image_concept, image_url: $('Set image_url').first().json.image_url, copy_status: 'pending', image_status: 'pending', revision: 0 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2860,
        240
      ],
      "id": "wf1-insert-post-0000000012",
      "name": "Insert fb_posts (public image URL)"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=__SUPABASE_URL__/rest/v1/fb_subtopics?id=eq.{{ $('Build Generator Prompt').first().json.subtopic_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
