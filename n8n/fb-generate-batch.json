              "leftValue": "={{ $json.slots.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "wfb-hasslots-0019",
      "name": "Has Slots?"
    },
    {
      "parameters": {
        "jsCode": "// Split the chosen slots into one item each for the generation loop.\nreturn ($json.slots || []).map(s => ({ json: s }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        280
