              }
            ]
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scheduled_date: $('Loop Over Slots').item.json.plan_date, target: 'both', pillar: $('Loop Over Slots').item.json.pillar, archetype: $('Loop Over Slots').item.json.archetype, subtopic_id: $('Loop Over Slots').item.json.subtopic_id, post_body: $('Parse JSON (tolerant)').item.json.post_body, first_comment: $('Parse JSON (tolerant)').item.json.first_comment, image_concept: $('Parse JSON (tolerant)').item.json.image_concept, image_url: $('Set image_url').item.json.image_url, copy_status: 'pending', image_status: 'pending', revision: 0 }) }}",
        "options": {}
