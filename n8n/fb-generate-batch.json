      "parameters": {
        "jsCode": "// Throttle ~3s between slots so Anthropic / image / GroupMe don't rate-limit (recall the\n// GroupMe 429s from rapid runs). Passes the current item through to loop back.\nawait new Promise(r => setTimeout(r, 3000));\nreturn $input.all();"
      },
