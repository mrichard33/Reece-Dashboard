      "id": "wfb-loop-000000004",
      "name": "Loop Over Slots"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "__ANTHROPIC_API_KEY__"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: '__ANTHROPIC_MODEL__', max_tokens: 1200, system: $json.system, messages: [ { role: 'user', content: $json.user } ] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        320
      ],
      "id": "wfb-anthropic-gen05",
      "name": "Anthropic: Generator"
    },
    {
      "parameters": {
        "jsCode": "// Tolerant JSON parse of the generator object { post_body, first_comment, image_concept, ... }.\nlet t = $json.content?.[0]?.text || '';\nt = t.replace(/\\`\\`\\`json|\\`\\`\\`/g, '').trim();\nlet out;\ntry { out = JSON.parse(t); } catch (e) { const m = t.match(/\\{[\\s\\S]*\\}/); out = m ? JSON.parse(m[0]) : {}; }\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        320
      ],
      "id": "wfb-parse-00000006",
      "name": "Parse JSON (tolerant)"
    },
    {
