      "id": "wfb-verify-00000002",
      "name": "Verify Secret"
    },
    {
      "parameters": {
        "jsCode": "// Capped batch fill. Pick up to \\`max\\` planned slots (plan_date >= today, no fb_posts\n// row yet), oldest first, and pre-build each slot's generator prompt. All Supabase reads\n// happen here (this.helpers.httpRequest) so PostgREST arrays don't fan out. Emits ONE item\n// per chosen slot for the loop below; emits nothing when there is nothing to fill.\nconst body = $('Webhook (fb-generate-batch)').first().json.body || {};\nconst MAX_HARD = Number($env.MAX_PER_GENERATION || 7);\nlet max = Number(body.max || MAX_HARD);\nif (!(max > 0)) max = MAX_HARD;\nmax = Math.min(max, MAX_HARD);\nconst today = $now.toFormat('yyyy-LL-dd');\nconst SB = '__SUPABASE_URL__';\nconst KEY = 'YOUR_SUPABASE_SERVICE_ROLE_KEY';\nconst h = { apikey: KEY, Authorization: 'Bearer ' + KEY };\nconst planned = await this.helpers.httpRequest({ method: 'GET', url: SB + '/rest/v1/fb_content_plan?status=eq.planned&plan_date=gte.' + today + '&select=id,plan_date,pillar,archetype,subtopic_id&order=plan_date.asc', headers: h, json: true });\nconst posts = await this.helpers.httpRequest({ method: 'GET', url: SB + '/rest/v1/fb_posts?select=scheduled_date&scheduled_date=gte.' + today, headers: h, json: true });\nconst taken = new Set((posts || []).map(p => p.scheduled_date));\nconst subs = await this.helpers.httpRequest({ method: 'GET', url: SB + '/rest/v1/fb_subtopics?select=id,subtopic,pillar,times_used', headers: h, json: true });\nconst subById = Object.fromEntries((subs || []).map(s => [s.id, s]));\nconst prompts = await this.helpers.httpRequest({ method: 'GET', url: SB + '/rest/v1/fb_messaging_prompts?is_active=eq.true&select=name,body', headers: h, json: true });\nconst byName = Object.fromEntries((prompts || []).map(p => [p.name, p.body]));\nconst bankArr = await this.helpers.httpRequest({ method: 'GET', url: SB + '/rest/v1/fb_message_bank?is_active=eq.true&select=variables&limit=1', headers: h, json: true });\nconst bank = (bankArr && bankArr[0] && bankArr[0].variables) || {};\nconst system = byName['style_guide'] || '';\nconst chosen = (planned || []).filter(s => !taken.has(s.plan_date)).slice(0, max);\nconst slots = chosen.map(s => {\n  const st = subById[s.subtopic_id] || {};\n  const user = (byName['generator'] || '')\n    .replaceAll('{{style_guide}}', system)\n    .replaceAll('{{message_bank}}', JSON.stringify(bank))\n    .replaceAll('{{pillar}}', s.pillar || st.pillar || '')\n    .replaceAll('{{archetype}}', s.archetype || '')\n    .replaceAll('{{subtopic}}', st.subtopic || '');\n  return { plan_id: s.id, plan_date: s.plan_date, pillar: s.pillar || st.pillar || '', archetype: s.archetype, subtopic_id: s.subtopic_id || null, times_used: st.times_used || 0, system, user };\n});\n// Always emit exactly one control item so the empty case still routes & responds.\nreturn [{ json: { slots } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "id": "wfb-select-0000003",
      "name": "Select Slots"
    },
    {
      "parameters": {
        "conditions": {
