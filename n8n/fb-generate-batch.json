        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-image-1', prompt: $json.content?.[0]?.text || '', size: '1024x1024', n: 1 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1320,
        320
      ],
      "id": "wfb-genimg-000008",
      "name": "Generate Image (swappable)"
    },
    {
      "parameters": {
        "jsCode": "// Decode the base64 image and prepare it as binary for upload.\nconst b64 = $json.data?.[0]?.b64_json;\nif (!b64) throw new Error('No image returned');\nconst path = `${$now.toFormat('yyyy-LL-dd')}-${Math.random().toString(36).slice(2,10)}.png`;\nreturn [{ json: { path }, binary: { data: await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), path, 'image/png') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        320
      ],
      "id": "wfb-decode-00009",
      "name": "Decode Image"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=__SUPABASE_URL__/storage/v1/object/fb-images/{{ $json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "x-upsert",
              "value": "true"
            },
            {
              "name": "Content-Type",
              "value": "image/png"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1760,
        320
      ],
      "id": "wfb-upload-0010",
      "name": "Upload to fb-images"
    },
    {
      "parameters": {
        "jsCode": "// Public read URL for the uploaded image (note the /public/ segment).\nreturn [{ json: { image_url: `${$env.SUPABASE_URL || '__SUPABASE_URL__'}/storage/v1/object/public/fb-images/${$('Decode Image').item.json.path}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        320
      ],
      "id": "wfb-seturl-0011",
      "name": "Set image_url"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__SUPABASE_URL__/rest/v1/fb_posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
              },
