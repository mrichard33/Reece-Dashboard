    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('FB Config').first().json.graph_version }}/{{ $('FB Config').first().json.page_id }}/feed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Loop Posts').item.json.post_body, access_token: $('FB Config').first().json.token }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1984, 304],
      "id": "wf4-publish-feed-012",
      "name": "Publish to Feed",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Both publish nodes converge here. Normalize the Graph response so every\n// downstream node reads the FB post id from one place — after Post First\n// Comment runs, $json would otherwise be the COMMENT id, which broke permalinks.\nconst j = $json;\nreturn [{ json: { fb_post_id: String(j.post_id || j.id || '') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2192, 208],
      "id": "wf4-capture-postid-020",
      "name": "Capture Post ID"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "wf4-hascomment-cond",
              "leftValue": "={{ $('Loop Posts').item.json.first_comment }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2384, 208],
      "id": "wf4-hascomment-013",
      "name": "Has first comment?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('FB Config').first().json.graph_version }}/{{ $('Capture Post ID').first().json.fb_post_id }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Loop Posts').item.json.first_comment, access_token: $('FB Config').first().json.token }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [2608, 128],
      "id": "wf4-comment-00014",
      "name": "Post First Comment",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://rcjcgjlqzepicbwhnnjl.supabase.co/rest/v1/fb_posts?id=eq.{{ $('Loop Posts').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpMultipleHeadersAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ page_posted_at: new Date().toISOString(), page_permalink: 'https://www.facebook.com/' + $('Capture Post ID').first().json.fb_post_id, last_publish_error: null }, $('Loop Posts').item.json.target === 'page' ? { status: 'posted', posted_by: 'system:page', posted_at: new Date().toISOString() } : {})) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [2832, 208],
      "id": "wf4-mark-pageleg-015",
      "name": "Mark Page Leg",
      "credentials": { "httpMultipleHeadersAuth": { "id": "E0rGNWmOCXvZ4oYb", "name": "LP Supabase Account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groupme.com/v3/bots/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bot_id: '75c281957bf9655f47833a5248', text: '✅ Posted to Page for ' + $('Loop Posts').item.json.scheduled_date + ' — https://www.facebook.com/' + $('Capture Post ID').first().json.fb_post_id }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [3040, 208],
      "id": "wf4-groupme-ok-016",
      "name": "GroupMe Notify",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://rcjcgjlqzepicbwhnnjl.supabase.co/rest/v1/fb_posts?id=eq.{{ $('Loop Posts').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpMultipleHeadersAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ last_publish_error: (($json.error && ($json.error.message || JSON.stringify($json.error))) || 'Graph publish failed') }) }}",
