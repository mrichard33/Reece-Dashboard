      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [448, 128],
      "id": "wf4-fetch-token-003",
      "name": "Fetch FB Token",
      "credentials": { "httpMultipleHeadersAuth": { "id": "E0rGNWmOCXvZ4oYb", "name": "LP Supabase Account" } }
    },
    {
      "parameters": {
        "jsCode": "// PostgREST returns arrays; the HTTP node may wrap them in .body. Normalize both\n// fetches into one config item downstream nodes read as $('FB Config').first().json.\nfunction firstRow(resp) {\n  const j = resp;\n  const data = Array.isArray(j) ? j : (j && j.body !== undefined ? j.body : j);\n  return Array.isArray(data) ? (data[0] || {}) : (data || {});\n}\nconst s = firstRow($('Fetch FB Config').first().json);\nconst sec = firstRow($('Fetch FB Token').first().json);\nreturn [{ json: {\n  enabled: s.auto_publish_enabled === true,\n  page_id: s.fb_page_id || '',\n  graph_version: s.fb_graph_version || 'v25.0',\n  token: sec.value || ''\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 128],
      "id": "wf4-config-0000004",
      "name": "FB Config"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "wf4-gate-cond-1",
              "leftValue": "={{ $('FB Config').first().json.enabled && $('FB Config').first().json.page_id !== '' && $('FB Config').first().json.token !== '' }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 128],
      "id": "wf4-gate-00000005",
      "name": "Gate (enabled + configured?)"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1104, 0],
      "id": "wf4-disabled-0006",
      "name": "Disabled — no-op"
    },
    {
      "parameters": {
        "url": "=https://rcjcgjlqzepicbwhnnjl.supabase.co/rest/v1/fb_posts?status=eq.approved&target=in.(page,both)&page_posted_at=is.null&publish_attempts=lt.3&scheduled_date=lte.{{ $now.toFormat('yyyy-LL-dd') }}&or=(publish_at.is.null,publish_at.lte.{{ $now.toISO() }})&select=*",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpMultipleHeadersAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1104, 208],
      "id": "wf4-get-publishable-007",
      "name": "Get Publishable",
      "credentials": { "httpMultipleHeadersAuth": { "id": "E0rGNWmOCXvZ4oYb", "name": "LP Supabase Account" } }
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1328, 208],
      "id": "wf4-loop-00000008",
      "name": "Loop Posts"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://rcjcgjlqzepicbwhnnjl.supabase.co/rest/v1/fb_posts?id=eq.{{ $('Loop Posts').item.json.id }}&page_posted_at=is.null",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpMultipleHeadersAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Prefer", "value": "return=representation" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ publish_attempts: ($('Loop Posts').item.json.publish_attempts || 0) + 1 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1552, 208],
      "id": "wf4-claim-0000009",
      "name": "Claim (idempotency guard)",
      "credentials": { "httpMultipleHeadersAuth": { "id": "E0rGNWmOCXvZ4oYb", "name": "LP Supabase Account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "wf4-hasimage-cond",
              "leftValue": "={{ $('Loop Posts').item.json.image_url }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1760, 208],
      "id": "wf4-hasimage-010",
      "name": "Has image?"
